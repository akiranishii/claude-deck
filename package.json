{
  "name": "claude-deck",
  "productName": "Claude Deck",
  "version": "0.1.0",
  "description": "Local macOS dashboard to organize, launch, monitor and reopen Claude Code Remote Control sessions running on a remote VM.",
  "main": "out/main/index.js",
  "author": "Akira Nishii",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:unit && npm run test:py",
    "test:unit": "vitest run",
    "test:py": "python3 -m unittest discover -s tests/python -v",
    "test:remote": "CDECK_REMOTE_TESTS=1 vitest run --config vitest.remote.config.mts",
    "package": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:dir": "npm run build && electron-builder --mac --arm64 --dir --publish never"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "playwright": "1.64",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
